#!/bin/sh
# "done = green" commit gate — installed by new-project.sh.
# Edit the 3 commands below for your stack. Leave one "" to skip that step.
#   Python: BUILD_CMD=""  TEST_CMD="pytest -q"  LINT_CMD="ruff check ."
#   Rust:   BUILD_CMD="cargo build"  TEST_CMD="cargo test"  LINT_CMD="cargo clippy -- -D warnings"
#   Go:     BUILD_CMD="go build ./..."  TEST_CMD="go test ./..."  LINT_CMD="go vet ./..."
BUILD_CMD="npm run -s typecheck"
TEST_CMD="npx vitest run"
LINT_CMD="npm run -s lint"  # ESLint flat config (strict type-checked) — adopted Stage 1 kickoff

# Skip inside CI (CI runs its own checks).
[ -n "$CI" ] && exit 0

# Loop heartbeat: while an interactive session holds the build loop paused
# (docs/loop/PAUSE exists), every milestone commit refreshes the pause so the
# loop's dead-man takeover doesn't fire mid-session. During loop cycles PAUSE
# does not exist (the loop removed it at takeover), so this is a no-op there.
[ -f docs/loop/PAUSE ] && touch docs/loop/PAUSE

# Docs-only fast-path: if EVERY staged file is markdown, it can't affect build/test/lint.
STAGED=$(git diff --cached --name-only)
NON_DOC=$(printf '%s\n' "$STAGED" | grep -vE '\.md$')
if [ -n "$STAGED" ] && [ -z "$NON_DOC" ]; then
  printf '\n[gate] Docs-only (markdown) change — skipping build/test/lint.\n'
  # ...but NOT the prose gate. 87 of the last 266 commits took this path, and 61 of those
  # touched a CLAUDE.md or RESUME_HERE.md — so this is the path on which prose drift is
  # introduced. A gate on prose that the prose-only commit skips can only ever go red on
  # somebody else's commit, and a blocking gate with broken attribution is how --no-verify
  # gets learned. ~0.1 s, node directly, no vitest boot.
  printf '[gate] Checking instruction paths...\n\n'
  node scripts/gates/instructionPaths.ts || exit 1
  exit 0
fi

run_step() {  # $1 = label, $2 = command
  [ -z "$2" ] && return 0
  log="/tmp/gate-$1.log"
  if ! sh -c "$2" >"$log" 2>&1; then
    printf '\n❌ %s FAILED — commit aborted. Last lines:\n' "$1"; tail -20 "$log"
    printf '\nFull log: %s\n' "$log"; exit 1
  fi
  printf '  ✓ %s\n' "$1"
  # Print the MEASURED suite totals on success. Two commit messages (3adac1b, 8f332e9)
  # asserted 1002/1003 tests while this hook had just measured 1001 and printed only a
  # tick; c38b660 caught it by hand. A number on screen cannot be inferred from memory.
  if [ "$1" = tests ]; then
    # Capture, then require. The old form piped straight to sed and ended in `|| true`,
    # which was decorative three times over: a pipeline returns SED's status (always 0),
    # this file sets no `-e`, and run_step's return value is ignored at every call site.
    # So a reporter whose format moved printed nothing and the commit went green anyway —
    # the exact silent zero the comment above is about. `exit`, not `return`, for the
    # same reason the failure branch above uses it.
    totals=$(grep -E '^ *(Test Files|Tests) +[0-9]' "$log")
    if [ -z "$totals" ]; then
      printf '\n❌ tests passed but NO suite totals could be read from %s.\n' "$log"
      printf '   The reporter format moved. A green with no number on screen is not a\n'
      printf '   measurement — fix the grep before trusting it.\n\n'
      exit 1
    fi
    printf '%s\n' "$totals" | sed 's/^ */      /'
  fi
  return 0
}

if [ -z "$BUILD_CMD$TEST_CMD$LINT_CMD" ]; then
  printf '\n[gate] No build/test/lint commands set yet — edit .githooks/pre-commit. Allowing commit.\n\n'
  exit 0
fi
printf '\n[gate] build -> tests -> lint (bypass with --no-verify)\n\n'
run_step build "$BUILD_CMD"
run_step tests "$TEST_CMD"
run_step lint  "$LINT_CMD"
printf '\n✅ Gate passed — committing.\n\n'
